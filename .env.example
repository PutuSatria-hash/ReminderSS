# Turso Cloud SQLite (wajib untuk hosting Vercel; kosongkan jika ingin pakai file lokal ./data/monitor.db)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Opsional: Secret untuk verifikasi signature HMAC-SHA256 GitHub Webhook
GITHUB_WEBHOOK_SECRET=
